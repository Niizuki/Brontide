  "purpose": "Deterministic byte forms for the portable representation. These are the reason Decision 1 chose deterministic CBOR: a cross-stack golden vector needs one encoding per value. build/verify-portable-binding.ps1 re-derives every 'cbor' field from its 'value' description and fails on any divergence, so these bytes are verified rather than asserted.",
  "valueDescription": {
    "note": "The 'value' field describes a shaped value using explicit kind discriminators. The wire form is schema-guided and carries no discriminators; the description exists so the golden bytes can be recomputed without loading either stack.",
    "kinds": {
      "record": "{ kind, fields: { name: value }, fragments: { 'name@version': { name: value } } }",
      "sequence": "{ kind, items: [value] }",
      "choice": "{ kind, case, value }",
      "text": "{ kind, value }",
      "boolean": "{ kind, value }",
      "integer": "{ kind, value }",
      "decimal": "{ kind, exponent, mantissa }",
      "bytes": "{ kind, hex }",
      "unit": "{ kind }"
    }
  },
  "encodings": [
    {
      "id": "G1-COOLING-COMMAND-MINIMAL",
      "shape": { "name": "interchange.tests.cooling.command", "version": 1 },
      "demonstrates": [
        "Record encodes as a two-item array of [fields map, fragments map].",
        "An absent optional field is omitted rather than encoded as null.",
        "Deterministic key order puts 'loop' before 'enabled' because the encoded key 0x64... sorts before 0x67.... Ordinal string order would reverse them, which is the divergence PB2 and PB3 must handle."
      ],
      "value": {
        "kind": "record",
        "fields": {
          "loop": { "kind": "text", "value": "primary" },
          "enabled": { "kind": "boolean", "value": true }
        },
        "fragments": {}
      },
      "cbor": "82a2646c6f6f70677072696d61727967656e61626c6564f5a0"
    },
    {
