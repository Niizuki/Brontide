<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Brontide.Minimal.Model\Brontide.Minimal.Model.fsproj" />
    <ProjectReference Include="..\..\src\Brontide.Minimal.Kernel\Brontide.Minimal.Kernel.fsproj" />
    <ProjectReference Include="..\..\src\Brontide.Minimal.Binding\Brontide.Minimal.Binding.fsproj" />
    <ProjectReference Include="..\..\src\Brontide.Minimal.Experimental.Enrichment\Brontide.Minimal.Experimental.Enrichment.fsproj" />
    <ProjectReference Include="..\..\src\Brontide.Minimal.Vocabularies.Cooling\Brontide.Minimal.Vocabularies.Cooling.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\interchange\**\*"
          Link="interchange\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The neutral portable-binding contract is read, never restated: the vectors and golden
         encodings are the authority these tests measure this stack against. -->
    <None Include="..\..\..\binding\portable\**\*.json"
          Link="binding\portable\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\binding\portable\**\*.md"
          Link="binding\portable\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The Channel 0.1 vectors are the source of the coverage accounting, so the ids this stack
         claims to execute are checked against the authored file rather than against a copy of it. -->
    <None Include="..\..\..\conformance\channel-0.1-vectors.json"
          Link="conformance\channel-0.1-vectors.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="InterchangeTests.fs" />
    <Compile Include="Portable\PortableTestHarness.fs" />
    <Compile Include="Portable\PortableEncodingTests.fs" />
    <Compile Include="Portable\PortableEstablishmentTests.fs" />
    <Compile Include="Portable\PortableAuthorityAndResourceTests.fs" />
    <Compile Include="Portable\PortableLifecycleAndChannelTests.fs" />
    <Compile Include="Portable\PortablePlanObservationAndParityTests.fs" />
    <Compile Include="Portable\PortableVectorCoverageTests.fs" />
    <Compile Include="Portable\PortableRealizationParityTests.fs" />
    <Compile Include="Portable\PortableChannelVectorCoverageTests.fs" />
    <Compile Include="Portable\PortableCrossProcessTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
