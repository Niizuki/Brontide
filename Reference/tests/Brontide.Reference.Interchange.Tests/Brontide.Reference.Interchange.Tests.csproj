<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Brontide.Reference.Core\Brontide.Reference.Core.csproj" />
    <ProjectReference Include="..\..\src\Brontide.Reference.Experimental.Binding\Brontide.Reference.Experimental.Binding.csproj" />
    <ProjectReference Include="..\..\src\Brontide.Reference.Experimental.Enrichment\Brontide.Reference.Experimental.Enrichment.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\interchange\**\*"
          Link="interchange\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The neutral portable-binding contract is read, never restated: the vectors and golden
         encodings the tests assert against are the checked-in data-only artifacts. -->
    <None Include="..\..\..\binding\portable\**\*.json"
          Link="binding\portable\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The Channel 0.1 vectors are the source of the coverage accounting, so the ids this stack
         claims to execute are checked against the authored file rather than against a copy of it. -->
    <None Include="..\..\..\conformance\channel-0.1-vectors.json"
          Link="conformance\channel-0.1-vectors.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
